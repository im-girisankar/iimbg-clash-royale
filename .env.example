# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Auth.js — run `npx auth secret` to generate
AUTH_SECRET=

# Production only. Pins the callback host so it cannot drift to a
# deployment-specific Vercel URL. Leave unset locally.
# AUTH_URL=https://your-domain/api/auth
